# Copy to .env and adjust. Never commit real secrets.

# With docker-compose: postgresql+psycopg://professor:professor@localhost:5432/grad_connect
# With a local Homebrew PostgreSQL: postgresql+psycopg://localhost/grad_connect
DATABASE_URL=postgresql+psycopg://professor:professor@localhost:5432/grad_connect

# Local sentence-embedding model (no generative LLM anywhere in this system)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Crawler
MAX_PAGES_PER_PROFESSOR=10

# Chunking (approximate tokens)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Minimum cosine similarity for a chunk to count as a match. Without a floor,
# vector search returns its nearest neighbours for any query, however
# off-topic. Tuned for bge-small; re-measure if you change EMBEDDING_MODEL.
MIN_SIMILARITY=0.65

# Professors CSV consumed by scripts/ingest.py
PROFESSORS_CSV=data/data.csv

# Frontend → backend URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
